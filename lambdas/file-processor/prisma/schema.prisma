generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  ADMIN
  USER
}

enum FileStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  users     User[]
  files     File[]
  sales     SalesRecord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  company      Company  @relation(fields: [companyId], references: [id])
  files        File[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model File {
  id             String            @id @default(uuid())
  companyId      String
  uploadedById   String
  originalName   String
  s3Key          String?
  status         FileStatus        @default(UPLOADED)
  totalRows      Int               @default(0)
  validRows      Int               @default(0)
  invalidRows    Int               @default(0)
  company        Company           @relation(fields: [companyId], references: [id])
  uploadedBy     User              @relation(fields: [uploadedById], references: [id])
  errors         ProcessingError[]
  salesRecords   SalesRecord[]
  createdAt      DateTime          @default(now())
  processedAt    DateTime?
  updatedAt      DateTime          @updatedAt

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("files")
}

model ProcessingError {
  id           String   @id @default(uuid())
  fileId       String
  rowNumber    Int
  columnName   String?
  errorMessage String
  file         File     @relation(fields: [fileId], references: [id])
  createdAt    DateTime @default(now())

  @@index([fileId])
  @@map("processing_errors")
}

model SalesRecord {
  id            String   @id @default(uuid())
  fileId        String
  companyId     String
  saleDate      DateTime
  customerEmail String
  amount        Decimal
  product       String
  file          File     @relation(fields: [fileId], references: [id])
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())

  @@index([companyId, saleDate])
  @@index([fileId])
  @@map("sales_records")
}
